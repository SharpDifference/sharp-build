{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.web.config.*",
    "scripts/*.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "packages/modkit/src/shared/**/*",
    "packages/modkit/src/main/**/*",
    "packages/modkit/src/host/shared.ts",
    "packages/modkit/src/host/main.ts",
    "packages/modkit/src/bridge/shared.ts",
    "packages/modkit/src/bridge/main.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // The @electron-toolkit base turns this off despite `strict`; on.
    "noImplicitAny": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@vx/modkit/host/*": ["./packages/modkit/src/host/*"],
      "@vx/modkit/*": ["./packages/modkit/src/*/index.ts"]
    }
  }
}
